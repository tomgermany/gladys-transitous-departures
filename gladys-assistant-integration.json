{
  "manifest_version": 1,
  "type": "provider",
  "name": "Transitous Departures",
  "description": {
    "en": "Nearby public transport departures on the Gladys dashboard, powered by Transitous.",
    "es": "Próximas salidas de transporte público en el panel de Gladys, con tecnología de Transitous.",
    "de": "ÖPNV-Abfahrten in der Nähe im Gladys-Dashboard, bereitgestellt von Transitous.",
    "fr": "Départs des transports publics à proximité sur le tableau de bord Gladys, grâce à Transitous."
  },
  "version": "1.5.0",
  "docker_image": "ghcr.io/tomgermany/gladys-transitous-departures:1.5.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/tomgermany/gladys-transitous-departures/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "widget_setup_info",
      "type": "section",
      "label": {
        "de": "Hinweis zur Einrichtung",
        "en": "Widget setup information",
        "fr": "Informations de configuration du widget"
      },
      "description": {
        "de": "Bitte legen Sie vor dem Hinzufügen des Widgets zum Dashboard die Koordinaten Ihres gewünschten Standorts fest. Benötigt werden Breitengrad und Längengrad im Dezimalformat, zum Beispiel 49.350 und 8.690. Beim Hinzufügen des Widgets stellen Sie anschließend Suchradius, Anzahl der Abfahrten und Aktualisierungsintervall ein. Der Standard-Suchradius beträgt 2.000 Meter.",
        "es": "Antes de añadir el widget al panel de control, especifique las coordenadas de la ubicación deseada. Se necesitan la latitud y la longitud en formato decimal, por ejemplo, 49,350 y 8,690. Al añadir el widget, configure a continuación el radio de búsqueda, el número de salidas y el intervalo de actualización. El radio de búsqueda predeterminado es de 2.000 metros.",
        "en": "Before adding the widget to your dashboard, determine the coordinates of your chosen location. You need latitude and longitude in decimal format, for example 49.350 and 8.690. When adding the widget, you can then configure the search radius, number of departures and refresh interval. The default search radius is 2,000 metres.",
        "fr": "Avant d’ajouter le widget à votre tableau de bord, déterminez les coordonnées du lieu choisi. Vous avez besoin de la latitude et de la longitude au format décimal, par exemple 49.350 et 8.690. Lors de l’ajout du widget, vous pourrez définir le rayon de recherche, le nombre de départs et l’intervalle d’actualisation. Le rayon de recherche par défaut est de 2 000 mètres."
      }
    }
  ],
  "widgets": [
    {
      "key": "transitous_departures",
      "label": {
        "en": "Nearby transit departures",
        "es": "Salidas de transporte público cercanas",
        "de": "ÖPNV-Abfahrten in der Nähe",
        "fr": "Départs à proximité"
      },
      "description": {
        "en": "Next public transport departures around a chosen location.",
        "es": "Próximas salidas del transporte público cerca de la ubicación seleccionada.",
        "de": "Die nächsten ÖPNV-Abfahrten an einem frei wählbaren Standort.",
        "fr": "Les prochains départs des transports publics autour d'un lieu choisi."
      },
      "icon": "map-pin",
      "settings": [
        {
          "key": "house",
          "type": "select",
          "source": "houses",
          "label": {
            "en": "Select a Gladys house (optional)",
            "es": "Selecciona una casa de Gladys (opcional)",
            "de": "Gladys-Haus auswählen (optional)",
            "fr": "Choisir une maison Gladys (facultatif)"
          }
        },
        {
          "key": "latitude",
          "type": "number",
          "label": {
            "en": "Latitude",
            "es": "Latitud",
            "de": "Breitengrad",
            "fr": "Latitude"
          },
          "placeholder": {
            "en": "e.g. 49.350",
            "es": "p. ej., 49 350",
            "de": "z.B. 49.350",
            "fr": "ex. 49.350"
          },
          "required": false,
          "min": -90,
          "max": 90
        },
        {
          "key": "longitude",
          "type": "number",
          "label": {
            "en": "Longitude",
            "es": "Longitud",
            "de": "Längengrad",
            "fr": "Longitude"
          },
          "placeholder": {
            "en": "e.g. 8.690",
            "es": "p. ej., 49 350",
            "de": "z. B. 8.690",
            "fr": "ex. 8.690"
          },
          "required": false,
          "min": -180,
          "max": 180
        },
        {
          "key": "radius",
          "type": "number",
          "label": {
            "en": "Search radius (metres)",
            "es": "Radio de búsqueda (metros)",
            "de": "Suchradius (Meter)",
            "fr": "Rayon de recherche (mètres)"
          },
          "required": true,
          "default": 2000,
          "min": 100,
          "max": 50000
        },
        {
          "key": "count",
          "type": "select",
          "label": {
            "en": "Number of departures",
            "es": "Número de salidas",
            "de": "Anzahl der Abfahrten",
            "fr": "Nombre de départs"
          },
          "required": true,
          "default": "6",
          "options": [
                {
                "value": "3",
                "label": {
                        "en": "3",
                        "de": "3",
                        "fr": "3"
                        }
                  },
                  {
                  "value": "6",
                  "label": {
                         "en": "6",
                          "de": "6",
                          "fr": "6"
                          }
                    }
                ]
        },
        {
          "key": "refresh_minutes",
          "type": "select",
          "label": {
            "en": "Refresh interval",
            "es": "Intervalo de actualización",
            "de": "Aktualisierungsintervall",
            "fr": "Intervalle d'actualisation"
          },
          "required": true,
          "default": "30",
          "options": [
            {
              "value": "10",
              "label": {
                "en": "10 minutes",
                "es": "10 minutos",
                "de": "10 Minuten",
                "fr": "10 minutes"
              }
            },
            {
              "value": "20",
              "label": {
                "en": "20 minutes",
                "es": "20 minutos",
                "de": "20 Minuten",
                "fr": "20 minutes"
              }
            },
            {
              "value": "30",
              "label": {
                "en": "30 minute",
                "es": "30 minutos",
                "de": "30 Minuten",
                "fr": "30 minutes"
              }
            },
            {
              "value": "40",
              "label": {
                "en": "40 minutes",
                "es": "40 minutos",
                "de": "40 Minuten",
                "fr": "40 minutes"
              }
            },
            {
              "value": "50",
              "label": {
                "en": "50 minutes",
                "es": "50 minutos",
                "de": "50 Minuten",
                "fr": "50 minutes"
              }
            },
            {
              "value": "60",
              "label": {
                "en": "60 minutes",
                "es": "60 minutos",
                "de": "60 Minuten",
                "fr": "60 minutes"
              }
            }
          ]
        },
        {
          "key": "contact",
          "type": "string",
          "label": {
            "en": "Contact for Transitous (email or website)",
            "es": "Datos de contacto de Transitous (correo electrónico o página web)",
            "de": "Kontakt für Transitous (E-Mail oder Website)",
            "fr": "Contact pour Transitous (e-mail ou site web)"
          },
          "placeholder": {
            "en": "e.g. https://github.com/tomgermany/gladys-transitous-departures",
            "es": "Por ejemplo: https://github.com/tomgermany/gladys-transitous-departures",
            "de": "z. B. https://github.com/tomgermany/gladys-transitous-departures",
            "fr": "ex. https://github.com/tomgermany/gladys-transitous-departures"
          },
          "required": true
        }
      ]
    }
  ]
}
