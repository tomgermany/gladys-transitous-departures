{
  "manifest_version": 1,
  "type": "provider",
  "name": "Transitous Departures",
  "description": {
    "en": "Nearby public transport departures on the Gladys dashboard, powered by Transitous.",
    "de": "ÖPNV-Abfahrten in der Nähe im Gladys-Dashboard, bereitgestellt von Transitous.",
    "fr": "Départs des transports publics à proximité sur le tableau de bord Gladys, grâce à Transitous."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/tomgermany/gladys-transitous-departures:1.0.0",
  "gladys_version": ">=5.1.0",
  "categories": ["services"],
  "transports": ["cloud"],
  "widgets": [
    {
      "key": "transitous_departures",
      "label": {
        "en": "Nearby transit departures",
        "de": "ÖPNV-Abfahrten in der Nähe",
        "fr": "Départs à proximité"
      },
      "description": {
        "en": "Next public transport departures around a chosen location.",
        "de": "Die nächsten ÖPNV-Abfahrten an einem frei wählbaren Standort.",
        "fr": "Les prochains départs des transports publics autour d'un lieu choisi."
      },
      "icon": "map-pin",
      "settings": [
        {
          "key": "latitude",
          "type": "number",
          "label": {
            "en": "Latitude",
            "de": "Breitengrad",
            "fr": "Latitude"
          },
          "placeholder": {
            "en": "e.g. 49.350",
            "de": "z. B. 49.350",
            "fr": "ex. 49.350"
          },
          "required": true,
          "min": -90,
          "max": 90
        },
        {
          "key": "longitude",
          "type": "number",
          "label": {
            "en": "Longitude",
            "de": "Längengrad",
            "fr": "Longitude"
          },
          "placeholder": {
            "en": "e.g. 8.690",
            "de": "z. B. 8.690",
            "fr": "ex. 8.690"
          },
          "required": true,
          "min": -180,
          "max": 180
        },
        {
          "key": "radius",
          "type": "number",
          "label": {
            "en": "Search radius (metres)",
            "de": "Suchradius (Meter)",
            "fr": "Rayon de recherche (mètres)"
          },
          "required": true,
          "default": 2000,
          "min": 100,
          "max": 50000
        },
        {
          "key": "count",
          "type": "select",
          "label": {
            "en": "Number of departures",
            "de": "Anzahl der Abfahrten",
            "fr": "Nombre de départs"
          },
          "required": true,
          "default": "5",
          "options": [
            {
              "value": "5",
              "label": {
                "en": "5",
                "de": "5",
                "fr": "5"
              }
            },
            {
              "value": "6",
              "label": {
                "en": "6",
                "de": "6",
                "fr": "6"
              }
            },
            {
              "value": "7",
              "label": {
                "en": "7",
                "de": "7",
                "fr": "7"
              }
            },
            {
              "value": "8",
              "label": {
                "en": "8",
                "de": "8",
                "fr": "8"
              }
            }
          ]
        },
        {
          "key": "refresh_minutes",
          "type": "select",
          "label": {
            "en": "Refresh interval",
            "de": "Aktualisierungsintervall",
            "fr": "Intervalle d'actualisation"
          },
          "required": true,
          "default": "30",
          "options": [
            {
              "value": "10",
              "label": {
                "en": "10 minutes",
                "de": "10 Minuten",
                "fr": "10 minutes"
              }
            },
            {
              "value": "20",
              "label": {
                "en": "20 minutes",
                "de": "20 Minuten",
                "fr": "20 minutes"
              }
            },
            {
              "value": "30",
              "label": {
                "en": "30 minutes",
                "de": "30 Minuten",
                "fr": "30 minutes"
              }
            },
            {
              "value": "40",
              "label": {
                "en": "40 minutes",
                "de": "40 Minuten",
                "fr": "40 minutes"
              }
            },
            {
              "value": "50",
              "label": {
                "en": "50 minutes",
                "de": "50 Minuten",
                "fr": "50 minutes"
              }
            },
            {
              "value": "60",
              "label": {
                "en": "60 minutes",
                "de": "60 Minuten",
                "fr": "60 minutes"
              }
            }
          ]
        },
        {
          "key": "contact",
          "type": "string",
          "label": {
            "en": "Contact for Transitous (email or website)",
            "de": "Kontakt für Transitous (E-Mail oder Website)",
            "fr": "Contact pour Transitous (e-mail ou site web)"
          },
          "placeholder": {
            "en": "e.g. https://github.com/tomgermany/gladys-transitous-departures",
            "de": "z. B. https://github.com/tomgermany/gladys-transitous-departures",
            "fr": "ex. https://github.com/tomgermany/gladys-transitous-departures"
          },
          "required": true
        }
      ]
    }
  ]
}
